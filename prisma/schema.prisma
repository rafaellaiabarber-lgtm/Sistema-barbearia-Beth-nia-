generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BARBEIRO
}

enum StatusAtendimento {
  AGUARDANDO
  EM_ATENDIMENTO
  CONCLUIDO
  CANCELADO
}

enum TipoMovimentoCaixa {
  ENTRADA
  SAIDA
}

enum PeriodoComissao {
  HOJE
  SEMANA
  MES
}

enum StatusAssinatura {
  ATIVA
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
}

enum CategoriaDespesa {
  FIXA
  VARIAVEL
  TAXA_CARTAO
  PRO_LABORE
  IMPOSTO
  OUTRA
}

enum TipoConta {
  PAGAR
  RECEBER
}

enum StatusConta {
  PENDENTE
  PAGO
}

enum TipoMeta {
  FATURAMENTO
  ATENDIMENTOS
  TICKET_MEDIO
  CLIENTES_NOVOS
  VENDAS_PRODUTO
}

enum TipoMaterialTreinamento {
  TEXTO
  LINK
  VIDEO
  ARQUIVO
}

model Usuario {
  id         String    @id @default(cuid())
  nome       String
  login      String    @unique
  senhaHash  String
  role       Role
  barbeiroId String?   @unique
  barbeiro   Barbeiro? @relation(fields: [barbeiroId], references: [id])
  criadoEm   DateTime  @default(now())
}

model Barbeiro {
  id                      String              @id @default(cuid())
  nome                    String
  telefone                String?
  fotoUrl                 String?
  ativo                   Boolean             @default(true)
  pausadoEm               DateTime?
  comissaoPercentual      Int                 @default(50)
  metaFaturamentoCentavos Int?
  bonificacaoCentavos     Int?
  usuario                 Usuario?
  atendimentos            Atendimento[]       @relation("BarbeiroAtendeu")
  atendimentosPreferidos  Atendimento[]       @relation("BarbeiroPreferido")
  pagamentosComissao      PagamentoComissao[]
  metas                   Meta[]
  vendasProduto           VendaProduto[]
  indicacoes              Indicacao[]
  assinaturasVendidas     Assinatura[]
  campanhasVenda          CampanhaVenda[]
  jornadas                JornadaTrabalho[]
  criadoEm                DateTime            @default(now())
}

model JornadaTrabalho {
  id         String   @id @default(cuid())
  barbeiro   Barbeiro @relation(fields: [barbeiroId], references: [id], onDelete: Cascade)
  barbeiroId String
  diaSemana  Int
  horaInicio String
  horaFim    String

  @@unique([barbeiroId, diaSemana])
}

model Indicacao {
  id           String    @id @default(cuid())
  barbeiro     Barbeiro  @relation(fields: [barbeiroId], references: [id])
  barbeiroId   String
  nome         String
  telefone     String
  contatada    Boolean   @default(false)
  contatadaEm  DateTime?
  convertida   Boolean   @default(false)
  convertidaEm DateTime?
  criadoEm     DateTime  @default(now())
}

// Sem @@unique de (barbeiroId, tipo): agora um barbeiro pode ter várias metas do
// mesmo tipo, desde que com escopo diferente (ex.: "Faturamento" geral e
// "Faturamento" só de um serviço). Edição identifica a meta pelo id, não pela
// combinação (barbeiroId, tipo).
model Meta {
  id         String      @id @default(cuid())
  barbeiro   Barbeiro    @relation(fields: [barbeiroId], references: [id])
  barbeiroId String
  tipo       TipoMeta
  // Se null, o período considerado é sempre o mês atual.
  dataInicio DateTime?
  dataFim    DateTime?
  // Escopo opcional: restringe a meta a um serviço específico (tipos baseados em
  // atendimento) ou a um produto específico (tipo VENDAS_PRODUTO).
  servico    Servico?    @relation(fields: [servicoId], references: [id])
  servicoId  String?
  produto    Produto?    @relation(fields: [produtoId], references: [id])
  produtoId  String?
  ativa      Boolean     @default(true)
  criadoEm   DateTime    @default(now())
  niveis     NivelMeta[]
}

// valorAlvo está em centavos para FATURAMENTO/TICKET_MEDIO, e em unidades inteiras para ATENDIMENTOS/CLIENTES_NOVOS.
model NivelMeta {
  id                  String @id @default(cuid())
  meta                Meta   @relation(fields: [metaId], references: [id], onDelete: Cascade)
  metaId              String
  ordem               Int
  nome                String
  valorAlvo           Int
  bonificacaoCentavos Int

  @@unique([metaId, ordem])
}

model Cliente {
  id           String        @id @default(cuid())
  nome         String
  telefone     String?       @unique
  criadoEm     DateTime      @default(now())
  atendimentos Atendimento[]
  assinaturas  Assinatura[]
}

model Servico {
  id                  String               @id @default(cuid())
  nome                String
  precoCentavos       Int
  custoCentavos       Int                  @default(0)
  duracaoMinutos      Int                  @default(30)
  comissaoPercentual  Int?
  ativo               Boolean              @default(true)
  pontuaRanking       Boolean              @default(true)
  criadoEm            DateTime             @default(now())
  atendimentoServicos AtendimentoServico[]
  metas               Meta[]
  itensCampanha       ItemCampanhaVenda[]
}

model Produto {
  id                 String              @id @default(cuid())
  nome               String
  precoCentavos      Int
  custoCentavos      Int                 @default(0)
  comissaoPercentual Int?
  ativo              Boolean             @default(true)
  criadoEm           DateTime            @default(now())
  vendas             VendaProduto[]
  metas              Meta[]
  itensCampanha      ItemCampanhaVenda[]
}

model CampanhaVenda {
  id         String              @id @default(cuid())
  barbeiro   Barbeiro            @relation(fields: [barbeiroId], references: [id])
  barbeiroId String
  titulo     String?
  ativa      Boolean             @default(true)
  criadoEm   DateTime            @default(now())
  itens      ItemCampanhaVenda[]
}

model ItemCampanhaVenda {
  id             String        @id @default(cuid())
  campanha       CampanhaVenda @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  campanhaId     String
  produto        Produto?      @relation(fields: [produtoId], references: [id])
  produtoId      String?
  servico        Servico?      @relation(fields: [servicoId], references: [id])
  servicoId      String?
  quantidadeAlvo Int
}

model VendaProduto {
  id                    String          @id @default(cuid())
  produto               Produto         @relation(fields: [produtoId], references: [id])
  produtoId             String
  barbeiro              Barbeiro?       @relation(fields: [barbeiroId], references: [id])
  barbeiroId            String?
  quantidade            Int             @default(1)
  precoUnitarioCentavos Int
  totalCentavos         Int
  comissaoPercentual    Int?
  formaPagamento        FormaPagamento?
  criadoEm              DateTime        @default(now())
}

model Atendimento {
  id                  String               @id @default(cuid())
  cliente             Cliente              @relation(fields: [clienteId], references: [id])
  clienteId           String
  barbeiro            Barbeiro?            @relation("BarbeiroAtendeu", fields: [barbeiroId], references: [id])
  barbeiroId          String?
  barbeiroPreferido   Barbeiro?            @relation("BarbeiroPreferido", fields: [barbeiroPreferidoId], references: [id])
  barbeiroPreferidoId String?
  status              StatusAtendimento    @default(AGUARDANDO)
  servicos            AtendimentoServico[]
  precoTotalCentavos  Int                  @default(0)
  formaPagamento      FormaPagamento?
  criadoEm            DateTime             @default(now())
  chamadoEm           DateTime?
  concluidoEm         DateTime?
  observacao          String?
}

model MovimentoCaixa {
  id             String             @id @default(cuid())
  tipo           TipoMovimentoCaixa
  descricao      String
  valorCentavos  Int
  formaPagamento FormaPagamento?
  categoria      CategoriaDespesa?
  criadoEm       DateTime           @default(now())
}

model PagamentoComissao {
  id            String          @id @default(cuid())
  barbeiro      Barbeiro        @relation(fields: [barbeiroId], references: [id])
  barbeiroId    String
  periodo       PeriodoComissao
  chave         String
  valorCentavos Int
  pagoEm        DateTime        @default(now())

  @@unique([barbeiroId, periodo, chave])
}

model AtendimentoServico {
  id                 String      @id @default(cuid())
  atendimento        Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  atendimentoId      String
  servico            Servico     @relation(fields: [servicoId], references: [id])
  servicoId          String
  nomeSnapshot       String
  precoCentavos      Int
  custoCentavos      Int         @default(0)
  comissaoPercentual Int?
}

model Plano {
  id                      String       @id @default(cuid())
  nome                    String
  precoCentavos           Int
  servicosIncluidosPorMes Int
  diasSemana              Int[]        @default([])
  ativo                   Boolean      @default(true)
  criadoEm                DateTime     @default(now())
  assinaturas             Assinatura[]
}

model Assinatura {
  id            String                @id @default(cuid())
  cliente       Cliente               @relation(fields: [clienteId], references: [id])
  clienteId     String
  plano         Plano                 @relation(fields: [planoId], references: [id])
  planoId       String
  barbeiro      Barbeiro?             @relation(fields: [barbeiroId], references: [id])
  barbeiroId    String?
  status        StatusAssinatura      @default(ATIVA)
  diaVencimento Int
  criadoEm      DateTime              @default(now())
  canceladaEm   DateTime?
  pagamentos    PagamentoAssinatura[]
}

model PagamentoAssinatura {
  id            String     @id @default(cuid())
  assinatura    Assinatura @relation(fields: [assinaturaId], references: [id])
  assinaturaId  String
  competencia   String
  valorCentavos Int
  pagoEm        DateTime   @default(now())

  @@unique([assinaturaId, competencia])
}

model ConfiguracaoTotem {
  id           String   @id @default("singleton")
  logoUrl      String?
  fundoUrl     String?
  // "imagem" ou "video". Null (fundoUrl definido em versões antigas) é tratado como imagem.
  fundoTipo    String?
  atualizadoEm DateTime @updatedAt
}

model ConfiguracaoFinanceira {
  id                            String   @id @default("singleton")
  taxaCartaoPercentualX100      Int?
  metaFaturamentoMensalCentavos Int?
  atualizadoEm                  DateTime @updatedAt
}

model ConfiguracaoRanking {
  id                           String   @id @default("singleton")
  pontosPorAtendimento         Int      @default(1)
  pontosPorVendaProduto        Int      @default(1)
  pontosPorAssinatura          Int      @default(1)
  pontosPorIndicacaoConvertida Int      @default(1)
  premio1LugarSemanal          String?
  premio2LugarSemanal          String?
  premio3LugarSemanal          String?
  premio1LugarMensal           String?
  premio2LugarMensal           String?
  premio3LugarMensal           String?
  pontuacaoMinimaPremio        Int?
  atualizadoEm                 DateTime @updatedAt
}

model ContaFinanceira {
  id            String            @id @default(cuid())
  tipo          TipoConta
  descricao     String
  valorCentavos Int
  vencimento    DateTime
  status        StatusConta       @default(PENDENTE)
  categoria     CategoriaDespesa?
  pagoEm        DateTime?
  movimentoId   String?
  criadoEm      DateTime          @default(now())
}

model MaterialTreinamento {
  id           String                  @id @default(cuid())
  titulo       String
  tipo         TipoMaterialTreinamento
  conteudo     String
  ordem        Int                     @default(0)
  criadoEm     DateTime                @default(now())
  atualizadoEm DateTime                @updatedAt
}
